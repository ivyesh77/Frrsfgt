# Copy into the deployment secret/config system; do not commit a populated .env.
APP_ENV=DEVELOPMENT
BUILD_VERSION=local
PORT=8787
ADMIN_PORT=8788
OPERATOR_PORT=8789
TRUSTED_PROXY_HOPS=0
ALLOWED_ORIGINS=http://localhost:5173
AUTH_BEARER_FALLBACK=1

# DEVELOPMENT/TEST only. Production refuses JSON/file storage.
STORAGE_BACKEND=json
SESSION_BACKEND=file
JOB_BACKEND=inline

# Required for STAGING/PRODUCTION.
# APP_ENV=STAGING
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@db.example/wager_arena
# DB_SSL=require
# SESSION_BACKEND=redis
# JOB_BACKEND=bullmq
# REDIS_URL=rediss://:password@redis.example:6379/0
# JOB_QUEUE_PREFIX=wager-arena-production
# METRICS_AUTH_TOKEN=provided-by-secret-manager
# PAYMENT_ENVIRONMENT=STAGING

# Provider secret references point to deployment-injected secret names only.
# Never put provider passwords, private keys or seed phrases in this file or the database.
# PAYMENT_WEBHOOK_SECRET_<ACCOUNT_ID>=injected-secret

# Never set this in STAGING/PRODUCTION. Provision the initial admin through a controlled
# migration/bootstrap procedure instead.
# ADMIN_BOOTSTRAP_NAME=local_admin
# ADMIN_BOOTSTRAP_PASSWORD=local-only-password
