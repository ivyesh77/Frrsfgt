{
  "name": "memory-match",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "tsx scripts/engine-selftest.ts",
    "test:client": "tsx scripts/engine-selftest.ts",
    "server:install": "npm install --prefix server",
    "server:dev": "npm run dev --prefix server",
    "server:test": "npm run test --prefix server",
    "test:all": "npm run test:client && npm run server:test"
  },
  "dependencies": {
    "framer-motion": "^13.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
